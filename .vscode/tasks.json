{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Servir le site sur 8080",
            "type": "shell",
            "command": "python3 -u -m http.server 8080",
            "options": { "cwd": "${workspaceFolder}" },
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": {
                "owner": "serveur-local",
                "pattern": { "regexp": "^$" },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "Serving HTTP"
                }
            }
        }
    ]
}
